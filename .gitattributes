# ============================================================================
#  Attributes — DofusArena 2.70
# ----------------------------------------------------------------------------
#  This branch does NOT use Git LFS. Everything committed here is source,
#  documentation, small tooling assets, and a small (~2.5 MB) redistributable
#  server-data subset, so plain Git objects are cheaper and simpler than an
#  LFS dependency.
#
#  The HEAVY copyrighted material is never committed at all — it is excluded
#  by .gitignore:
#    - client/compiled/   the runnable retail client + bundled JRE (~436 MB)
#    - server/data/       a local scratch copy of your own client's data
#
#  server/data-dist/ (data.bdat, indexes.bdat, maps/, *.jar) IS committed on
#  purpose — a maintainer-curated exception, see AGENTS.md and DISCLAIMER.md.
#
#  Line endings are intentionally NOT normalized (no `text=auto`): the repo
#  holds decompiled sources and byte-sensitive fixtures, and renormalizing
#  would create large spurious diffs.
# ============================================================================

# Binary files: never diff as text, never touch line endings.
*.jar    binary
*.exe    binary
*.dll    binary
*.so     binary
*.dylib  binary
*.class  binary

# Binary game data / fixtures
*.amw    binary
*.dat    binary
*.ade    binary
*.bdat   binary
*.pack   binary
*.bin    binary

# Fonts
*.ttf    binary
*.otf    binary
*.fnt    binary
*.pf     binary

# Images & audio
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.wav    binary
*.ogg    binary
*.mp3    binary

# Generated / vendored files — keep them out of language stats and diffs.
client/decompiled/**   linguist-generated=true
client/deobf-lab/**    linguist-vendored=true
