# ============================================================================
#  Git LFS — large / binary assets
# ----------------------------------------------------------------------------
#  This repo commits the compiled game client (client/compiled/, incl. a
#  bundled JRE) and a large body of binary game data (client/source/,
#  server/data/). Those live in Git LFS so the git history stays light.
#
#  NOTE: server build artifacts (*.exe / *.test under server/) are NOT
#  committed at all — they are excluded by .gitignore path scoping. Only the
#  client's binaries below are stored (via LFS).
# ============================================================================

# Executables & native libraries (client/compiled + bundled JRE)
*.exe    filter=lfs diff=lfs merge=lfs -text
*.dll    filter=lfs diff=lfs merge=lfs -text
*.so     filter=lfs diff=lfs merge=lfs -text
*.dylib  filter=lfs diff=lfs merge=lfs -text
*.jsa    filter=lfs diff=lfs merge=lfs -text

# Java archives
*.jar    filter=lfs diff=lfs merge=lfs -text

# Binary game data
*.amw    filter=lfs diff=lfs merge=lfs -text
*.dat    filter=lfs diff=lfs merge=lfs -text
*.ade    filter=lfs diff=lfs merge=lfs -text
*.pack   filter=lfs diff=lfs merge=lfs -text
*.bin    filter=lfs diff=lfs merge=lfs -text

# ICC color profiles / fonts
*.pf     filter=lfs diff=lfs merge=lfs -text
*.ttf    filter=lfs diff=lfs merge=lfs -text
*.otf    filter=lfs diff=lfs merge=lfs -text
*.fnt    filter=lfs diff=lfs merge=lfs -text

# Images & audio (client assets)
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.gif    filter=lfs diff=lfs merge=lfs -text
*.ico    filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.ogg    filter=lfs diff=lfs merge=lfs -text
*.mp3    filter=lfs diff=lfs merge=lfs -text
