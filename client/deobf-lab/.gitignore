# deobf-lab — keep scripts, mappings and docs in git; ignore heavy/generated artifacts.

# Downloaded third-party tool jars (SpecialSource, tiny-remapper, Vineflower, ...)
tools/*.jar

# Remapped bytecode jars (derived from the git-ignored, copyrighted core.jar)
build/

# Decompiled source of the remapped jar (derived from copyrighted client)
decompiled/

# Python cache
__pycache__/
*.pyc
