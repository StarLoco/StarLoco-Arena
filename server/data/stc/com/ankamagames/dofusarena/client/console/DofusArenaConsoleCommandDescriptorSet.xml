<commandList>

	<commandSet cmdPattern="common" name="common" help="Catégorie 'Common'">
		<command cmdPattern="chat" argsPattern="(.*)" class="com.ankamagames.dofusarena.client.console.command.common.ChatCommand" name="chat" help="Affiche/Masque le chat" />
		<command cmdPattern="zoom" argsPattern="(\+|\-)" class="com.ankamagames.dofusarena.client.console.command.common.ZoomCommand" name="zoom" help="Change le zoom de la camera" />
		<command cmdPattern="closeWindows" class="com.ankamagames.dofusarena.client.console.command.common.CloseAllWindowsCommand" name="closeWindows" help="Ferme toutes les fenêtres" />
		<command cmdPattern="onlineHelp" class="com.ankamagames.dofusarena.client.console.command.common.OnlineHelpCommand" name="onlineHelp" help="Ouvre l'aide en ligne" />
		<command cmdPattern="openMenu" class="com.ankamagames.dofusarena.client.console.command.common.OpenMenuCommand" name="openMenu" help="Ouvre le menu principal" />
		<command cmdPattern="maximizeChat" class="com.ankamagames.dofusarena.client.console.command.common.MaximizeChatCommand" name="maximizeChat" help="Maximise/Minimise le chat" />
	</commandSet>
	
	<commandSet cmdPattern="world" name="world" help="Catégorie 'World'">
		<command cmdPattern="inventory" class="com.ankamagames.dofusarena.client.console.command.world.CoachInventoryCommand" name="inventory" help="Affiche/Masque le classeur" />
		<command cmdPattern="statistics" class="com.ankamagames.dofusarena.client.console.command.world.CoachStatisticsCommand" name="statistics" help="Affiche/Masque les statistiques de Coach" />
		<command cmdPattern="equipment" class="com.ankamagames.dofusarena.client.console.command.world.CoachEquipmentCommand" name="equipment" help="Affiche/Masque l'équipement du coach" />
		<command cmdPattern="fusion" class="com.ankamagames.dofusarena.client.console.command.world.FusionLaboratoryCommand" name="fusion" help="Affiche/Masque la page de fusion" />
		<command cmdPattern="inventoryStatistics" class="com.ankamagames.dofusarena.client.console.command.world.CoachInventoryStatisticsCommand" name="inventoryStatistics" help="Affiche/Masque les statistiques de l'inventaire" />
		<command cmdPattern="teamManagement" class="com.ankamagames.dofusarena.client.console.command.world.TeamManagementCommand" name="teamManagement" help="Affiche/Masque la gestion de l'équipe" />
		<command cmdPattern="randomFight" class="com.ankamagames.dofusarena.client.console.command.world.CreateRandomFightSearchCommand" name="randomFight" help="Recherche un combat au hasard" />
		<command cmdPattern="move" argsPattern="(\p{Digit})" class="com.ankamagames.dofusarena.client.console.command.world.MoveCharacterCommand" name="move" help="Déplace le personnage" />
	</commandSet>
	
	
	<commandSet cmdPattern="fight" name="fight" help="Catégorie 'Fight'">
		<command cmdPattern="selectSpell" argsPattern="(\p{Digit})" class="com.ankamagames.dofusarena.client.console.command.fight.SpellSelectionCommand" name="selectSpell" help="Sélectionne le sort par index" />		
		<command cmdPattern="closeCombat" class="com.ankamagames.dofusarena.client.console.command.fight.CloseCombatSelectionCommand" name="closeCombat" help="Sélectionne le poing" />		
		<command cmdPattern="selectWeapon" argsPattern="(\p{Digit})" class="com.ankamagames.dofusarena.client.console.command.fight.WeaponSelectionCommand" name="selectWeapon" help="Sélectionne l'arme courante" />		
		<command cmdPattern="selectFighterCard" argsPattern="(\p{Digit})" class="com.ankamagames.dofusarena.client.console.command.fight.FighterCardSelectionCommand" name="selectFighterCard" help="Sélectionne la carte de combattant par index" />		
		<command cmdPattern="endTurn" class="com.ankamagames.dofusarena.client.console.command.fight.EndTurnCommand" name="endTurn" help="Termine le tour" />		
		<command cmdPattern="giveUp" class="com.ankamagames.dofusarena.client.console.command.fight.GiveUpCommand" name="giveUp" help="Abandonne le combat" />		
		<command cmdPattern="setDirection" argsPattern="(\p{Digit})" class="com.ankamagames.dofusarena.client.console.command.fight.TurnFighterCommand" name="turnFighter" help="Tourne le fighter dans la direction donnée" />		
		<command cmdPattern="move" argsPattern="(\p{Digit})" class="com.ankamagames.dofusarena.client.console.command.fight.MoveFighterCommand" name="move" help="Déplace le combattant" />
	</commandSet>
	
</commandList>

