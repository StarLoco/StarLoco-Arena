# Environment-variable overrides for configs/config.example.yaml.
# Copy to .env (git-ignored) and fill in real values for your deployment.
# Nested config keys use a double underscore, e.g. database.dsn ->
# ARENA_DATABASE__DSN. See ../docs/06-config-and-ops.md.

ARENA_DATABASE__DRIVER=postgres
ARENA_DATABASE__DSN=host=localhost user=arena password=CHANGE_ME dbname=arena sslmode=disable

ARENA_SERVER__LISTEN_ADDR=:443
ARENA_SERVER__BETA=false

ARENA_LOGGING__LEVEL=info
ARENA_LOGGING__FORMAT=json
